DATABASE_URL=postgresql://localhost/forkware
APPLE_CLIENT_ID=com.arjunakankipati.forkware
PORT=3000
RUST_LOG=info

# Claude stays disabled without a key. Never commit a real key.
ANTHROPIC_API_KEY=
# Comma-separated backend user UUIDs from authenticated GET /api/v1/me.
# Required when ANTHROPIC_API_KEY is set; Firebase UIDs and Apple subjects do not apply.
ASSISTANT_ALLOWED_USER_IDS=
