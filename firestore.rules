rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/mealos/{documentId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'payload', 'updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000;
      allow delete: if false;
    }

    function signedInAs(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }
  }
}
