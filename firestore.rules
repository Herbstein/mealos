rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/mealos/{documentId} {
      allow read: if signedInAsAllowedUser(userId);
      allow create, update: if signedInAsAllowedUser(userId)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'payload', 'updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000;
      allow delete: if false;
    }

    match /mealosAccess/{userId} {
      allow read, write: if false;
    }

    function signedInAsAllowedUser(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && get(/databases/$(database)/documents/mealosAccess/$(userId)).data.enabled == true;
    }
  }
}
